<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.tv-power" name="TV Power Menu" version="1.0.0" provider-name="lanbat">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.script" library="default.py"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Power menu for the TV box</summary>
    <description lang="en_GB">Restart Kodi, turn the screen off over CEC, switch to EmulationStation or chiaki-ng, or reboot.</description>
    <platform>all</platform>
    <license>MIT</license>
  </extension>
</addon>
