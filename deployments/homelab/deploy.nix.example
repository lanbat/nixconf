# deployments/homelab/deploy.nix — one site/profile. Not tracked by git.
#
# Copy to deploy.nix in this directory, then reference it from the root
# deploy.nix manifest (see deploy.nix.example at the repo root).
{ inputs, ... }:
{
  deployment = {
    domain = "CHANGE_ME";
    rootDomain = "CHANGE_ME";
    gatewayIp = "CHANGE_ME";
    lanSubnet = "CHANGE_ME";
    nfsIdmapdDomain = "home.lan";
    timezone = "Europe/London";
    phoneRegion = "GB";
    haLatitude = "51.5074";
    haLongitude = "-0.1278";
    haElevation = 11;
    # The conversation agent's LLM. An address on the loopback runs the model on
    # the server (services/llama-cpp.nix; model qwen3-1.7b or qwen3-4b):
    #   baseUrl = "http://127.0.0.1:8091/v1"; model = "qwen3-1.7b";
    # Any other URL is an OpenAI-compatible API, with its key in ha-llm-api-key.
    haLlm = {
      baseUrl = "CHANGE_ME";
      model = "CHANGE_ME";
    };
    # Where the voice assistant's heavy work runs (lib/voice-compute.nix).
    # "low-spec": the server does everything, with a small model in haLlm on
    # the loopback. "apple-silicon": a Mac on the LAN serves the LLM, and the
    # server uses the freed cores for a better speech-to-text model:
    #   voiceCompute.profile = "apple-silicon";
    #   haLlm = { baseUrl = "http://<mac-ip>:8080/v1"; model = "<model>"; apiKey = false; };
    voiceCompute.profile = "low-spec";
    voiceRooms = {
      "Office" = "server";
      "Living Room" = "pi-storage";
    };
    # People the assistant may recognise by voice, face or phone
    # (docs/people.md). Names only; recognition is never authority.
    # people = {
    #   alex.name = "Alex";
    #   sam.name = "Sam";
    # };
    # Xiaomi BLE bind keys for Home Assistant, from ha-xiaomi-ble.age
    # (see secrets/README.md).
    # haXiaomiBle = true;
    # Xiaomi BLE thermometers with a clock display (lanbatPlugins.xiaomi-clock).
    # xiaomiClocks = [ "A4:C1:38:00:00:01" ];

    # LAN DNS, for hosts with lanbatPlugins.dns: short names (torrent.lan
    # redirects to torrent.<domain>) and further LAN names.
    # dns = {
    #   shortSuffix = "lan";
    #   extraRecords.router = "10.0.0.1";
    # };

    # Echo Shows on TECHO5 (docs/techo5.md): the assistant router's body in
    # their room, with their keys in techo5-<name>-api-key.age.
    # techo5Devices = {
    #   kitchen = {
    #     address = "10.0.0.x";
    #     room = "Kitchen";
    #     playerName = "Echo Show 8"; # its Music Assistant player
    #     profiles.alex = {
    #       glance = [ "sensor.washer_status" ];
    #       immichPerson = "Alex";
    #       # todo = "todo.alex_todo";
    #       # reminders = "todo.alex_reminders";
    #     };
    #     household.calendars = [ "calendar.family" ];
    #   };
    # };

    # Android TV boxes, for lanbatPlugins.android.  Snapdroid needs no
    # configuration: snapserver publishes over mDNS (services/snapcast.nix).
    # androidDevices = {
    #   bedroom = {
    #     host = "10.0.0.x";
    #     packages = [ "de.badaix.snapcast" ];
    #     settings.global.screen_off_timeout = 600000;
    #     # Argosy Launcher (RomM client), as the box's default home screen.
    #     # See docs/android-devices.md#romm-through-argosy.
    #     # github = [
    #     #   { repo = "rommapp/argosy-launcher"; asset = "argosy-v*.[0-9].apk"; }
    #     # ];
    #     # homeActivity = "com.nendo.argosy/.MainActivity";
    #   };
    # };

    adminSshKey = "CHANGE_ME";
    zigbeeVendorId = "CHANGE_ME";
    zigbeeProductId = "CHANGE_ME";
    immich.adminEmail = "CHANGE_ME";
    # Optional — a WireGuard mesh for cross-host service traffic. Leave it out
    # to keep that traffic on the LAN. Tang and NFS stay on the LAN either way.
    # Needs an overlay block on each host below and secrets/overlay-<host>.age,
    # both from: nix run .#overlay-keys
    # overlay = {
    #   provider = "wireguard-mesh";
    #   subnet = "10.100.0.0/24";
    #   domain = "lanbat.internal";
    # };

    secrets = {
      provider = "agenix";
      root = ../../secrets;
    };

    # Optional — lanbat-justpark-parking plugin (JustPark + Frigate LPR alerts):
    # parkingGuard = {
    #   siteId = "CHANGE_ME";
    #   cameras = [ "c1" ];
    #   graceMinutes = 5;
    #   cooldownMinutes = 30;
    #   residentPlates = [ ];
    # };
  };

  hosts = {
    server = {
      role = "server";
      system = "x86_64-linux";
      networking = {
        ip = "CHANGE_ME";
        interface = "CHANGE_ME";
        hostname = "server";
      };
      # overlay = {
      #   ip = "10.100.0.1";
      #   publicKey = "CHANGE_ME";
      #   endpoint = "CHANGE_ME:51820"; # an address the other hosts can reach
      # };
      disks = {
        system = "/dev/disk/by-id/CHANGE_ME";
      };
      plugins = [
        inputs.self.lanbatPlugins.services
        # inputs.self.lanbatPlugins.xiaomi-clock
        # inputs.self.lanbatPlugins.dns
        # Music that follows people, lights and music off in empty rooms
        # (docs/people.md#acting-on-where-people-are); set
        # lanbat.homeAssistant.followMe in a module below, for example:
        #   lanbat.homeAssistant.followMe = {
        #     enable = true;
        #     dryRun = true;
        #     # lightsOffAny = true;
        #     rooms."Kitchen" = { lights = [ "light.kitchen_strip" ]; };
        #   };
        # inputs.self.lanbatPlugins.follow-me
        # inputs.lanbat-justpark-parking.lanbatPlugin
      ];
      # NixOS modules merged last. Frigate's cameras, zones and retention
      # (lanbat.services.frigate.settings) live in ./frigate.nix next to this
      # file, gitignored like it: copy deployments/example/frigate.nix there.
      # Evaluation fails while Frigate has no camera.
      #
      # Other services' settings have defaults and need a module only where the
      # site differs (docs/extensibility.md#service-settings), for example
      # Samba's shares (lanbat.services.samba.settings.shares) or the voice
      # pipeline's language, voice and ALSA card (lanbat.services.wyoming.settings),
      # or Syncthing's devices and folders (lanbat.services.syncthing.settings):
      #   {
      #     lanbat.services.syncthing.settings = {
      #       devices.laptop.id = "<Actions → Show ID on the laptop>";
      #       folders."<the laptop's folder ID>" = {
      #         label = "Documents";
      #         path = "/srv/storage/b/users/admin/sync/documents";
      #         devices = [ "laptop" ];
      #       };
      #     };
      #   }
      #
      # Music Assistant's radio stations, podcasts and video channels
      # (lanbat.services.music-assistant.settings, docs/deployment-checklist.md#3m-music-assistant):
      #   {
      #     lanbat.services.music-assistant.settings = {
      #       stations = [ { name = "BBC Radio 4"; } { name = "Darik"; } ];
      #       channels.computerphile.url = "https://www.youtube.com/@Computerphile/videos";
      #     };
      #   }
      modules = [
        ./frigate.nix
        # Rooms for Home Assistant devices that have none (docs/dashboards.md).
        {
          lanbat.services.home-assistant.settings.deviceAreas = {
            livingroom_lamp = "Living Room";
          };
        }
      ];
    };

    pi-storage = {
      role = "storage-pi";
      system = "aarch64-linux";
      platform = "raspberry-pi-5";
      networking = {
        ip = "CHANGE_ME";
        interface = "end0";
        hostname = "pi5";
      };
      # overlay = {
      #   ip = "10.100.0.2";
      #   publicKey = "CHANGE_ME";
      # };
      storage = {
        drives = {
          a = "CHANGE_ME";
          b = "CHANGE_ME";
        };
      };
      plugins = [
        inputs.self.lanbatPlugins.tv
        inputs.self.lanbatPlugins.voice
        # inputs.self.lanbatPlugins.dns
      ];
      # A satellite on the TV box: replies below full volume, so they don't
      # shout over a film (docs/pi3-satellite.md, section 9).
      # modules = [ { lanbat.voiceSatellite.lva.volume = 0.4; } ];
    };
  };
}
